# Minimal Doxyfile for TIVIDY (C++11). Run from the repository root:  doxygen Doxyfile
PROJECT_NAME           = "TIVIDY"
PROJECT_BRIEF          = "Generic workflow management engine with plug-and-play industry packs"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
MARKDOWN_SUPPORT       = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
HAVE_DOT               = NO
